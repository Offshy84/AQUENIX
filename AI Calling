<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>AQUENIX AI Caller</title>
<style>
*{box-sizing:border-box}
body{margin:0;background:#f3f6fb;color:#14213d;font-family:Arial,sans-serif}
header{background:#102b50;color:white;padding:25px 20px}
header h1{margin:0;font-size:25px;letter-spacing:1px}
header p{color:#c6d8ed;margin-bottom:0}
main{max-width:650px;margin:22px auto;padding:0 15px}
.card{background:white;border-radius:16px;padding:20px;margin-bottom:16px;box-shadow:0 4px 18px #102b5010}
h2{font-size:18px;margin-top:0}
select,input{width:100%;padding:13px;border:1px solid #d5deea;border-radius:9px;font-size:15px;margin:8px 0 15px}
button{border:0;border-radius:10px;padding:14px 17px;font-size:15px;font-weight:bold;cursor:pointer}
.primary{background:#1464c5;color:white;width:100%}
.secondary{background:#e8f1fc;color:#164d89}
.actions{display:grid;grid-template-columns:1fr 1fr;gap:10px}
.status{color:#52708f;font-size:14px;margin-top:12px}
#conversation{min-height:100px;background:#f5f8fc;padding:13px;border-radius:10px;white-space:pre-wrap;line-height:1.6}
footer{text-align:center;color:#718096;font-size:12px;padding:20px}
</style>
</head>
<body>
<header>
<h1>AQUENIX AI CALLER</h1>
<p>Multilingual business voice assistant</p>
</header>
<main>
<div class="card">
<h2>Voice assistant settings</h2>
<label>Choose language</label>
<select id="language">
<option value="gu-IN">Gujarati</option>
<option value="hi-IN">Hindi</option>
<option value="en-IN">English</option>
</select>
<label>Call mode (demo)</label>
<select id="mode">
<option>Incoming call assistant</option>
<option>Outgoing sales assistant</option>
</select>
<button class="primary" onclick="startAssistant()">Start voice assistant</button>
<p class="status" id="status">Ready to start your voice demo.</p>
</div>
<div class="card">
<h2>Talk to AQUENIX</h2>
<div id="conversation">નમસ્તે! AQUENIX માં આપનું સ્વાગત છે. તમે શું જાણવા માંગો છો?</div>
<br>
<div class="actions">
<button class="secondary" onclick="listen()">🎙 Speak</button>
<button class="secondary" onclick="speakReply()">🔊 Hear reply</button>
</div>
<label>Or type your message</label>
<input id="message" placeholder="Ask about AQUENIX products...">
<button class="primary" onclick="sendMessage()">Send message</button>
</div>
<div class="card">
<h2>Business capabilities</h2>
<p>✓ Gujarati, Hindi and English</p>
<p>✓ Product enquiries</p>
<p>✓ Customer conversations</p>
<p>✓ Sales enquiry assistance</p>
<p>✓ Voice interaction demo</p>
</div>
<div class="card">
<h2>Development status</h2>
<p>Version 1: Browser voice prototype</p>
<p>Real telephone integration: Not connected yet</p>
<p>AI API: Not connected yet</p>
</div>
</main>
<footer>© AQUENIX | Intelligent Voice Assistant</footer>
<script>
let lastReply="નમસ્તે! AQUENIX માં આપનું સ્વાગત છે.";
function replyFor(message,lang){
let m=message.toLowerCase();
if(lang==="gu-IN"){
if(/price|કિંમત|ભાવ/.test(m))return "AQUENIX ના ઉત્પાદનોની કિંમત જાણવા માટે કૃપા કરીને તમારું નામ અને સંપર્ક નંબર આપો.";
if(/product|ઉત્પાદન|પ્રોડક્ટ/.test(m))return "AQUENIX પાણીમાં ઓગાળીને ઉપયોગમાં લેવાતી ડ્રાય ક્લીનિંગ ટેબ્લેટ અને રિફિલ પ્રોડક્ટ્સ વિકસાવી રહ્યું છે.";
return "આભાર! AQUENIX વિશે વધુ માહિતી માટે કૃપા કરીને તમારું નામ અને સંપર્ક નંબર જણાવો. અમારી ટીમ તમને સંપર્ક કરશે.";
}
if(lang==="hi-IN"){
if(/price|कीमत|दाम/.test(m))return "AQUENIX उत्पादों की कीमत जानने के लिए कृपया अपना नाम और संपर्क नंबर बताएं।";
if(/product|उत्पाद/.test(m))return "AQUENIX पानी में घुलने वाली ड्राई क्लीनिंग टैबलेट और रिफिल उत्पाद विकसित कर रहा है।";
return "धन्यवाद! कृपया अपना नाम और संपर्क नंबर बताएं। हमारी टीम आपसे संपर्क करेगी।";
}
if(/price|cost|rate/.test(m))return "Please share your name and contact details. Our AQUENIX team can help you with product pricing.";
if(/product|clean|tablet|refill/.test(m))return "AQUENIX is developing water-activated dry cleaning tablets and refill products. What product information would you like?";
return "Thank you for contacting AQUENIX. Please share your name and contact details so our team can follow up.";
}
function sendMessage(){
let box=document.getElementById("message");
let msg=box.value.trim();
if(!msg)return;
let lang=document.getElementById("language").value;
lastReply=replyFor(msg,lang);
document.getElementById("conversation").textContent="You: "+msg+"\n\nAQUENIX: "+lastReply;
box.value="";
}
function speakReply(){
if(!("speechSynthesis" in window)){alert("Speech is not supported in this browser.");return;}
let lang=document.getElementById("language").value;
let utter=new SpeechSynthesisUtterance(lastReply);
utter.lang=lang;
speechSynthesis.cancel();
speechSynthesis.speak(utter);
}
function startAssistant(){
document.getElementById("status").textContent="Voice demo started. Tap Speak to talk to AQUENIX.";
speakReply();
}
function listen(){
let SR=window.SpeechRecognition||window.webkitSpeechRecognition;
if(!SR){document.getElementById("status").textContent="Speech recognition unavailable. Please type your message instead.";return;}
let rec=new SR();
rec.lang=document.getElementById("language").value;
rec.onstart=()=>document.getElementById("status").textContent="Listening... Speak now.";
rec.onresult=e=>{
document.getElementById("message").value=e.results[0][0].transcript;
sendMessage();
speakReply();
};
rec.onerror=e=>document.getElementById("status").textContent="Voice error: "+e.error+". You can type instead.";
rec.onend=()=>document.getElementById("status").textContent="Voice demo ready.";
rec.start();
}
</script>
</body>
</html>
